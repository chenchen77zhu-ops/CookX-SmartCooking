<?xml version="1.0" encoding="utf-8"?>
<!-- 实时烹饪通知展开样式：与首页 CookX Sense 卡片一致 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/live_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/live_card_bg">

    <ImageView
        android:id="@+id/live_pan"
        android:layout_width="170dp"
        android:layout_height="130dp"
        android:layout_gravity="end|top"
        android:alpha="0.9"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/live_card_pan" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/live_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CookX Sense"
            android:textColor="#FFF6F3EE"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/live_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● 已连接"
            android:textColor="#FF7EE6A4"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="当前锅内温度"
            android:textColor="#B3F6F3EE"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/live_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/live_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="130dp"
            android:layout_height="5dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/live_progress" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/live_pill_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/live_dish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="正在烹饪中"
                android:textColor="#FFF6F3EE"
                android:textSize="13sp" />

            <Chronometer
                android:id="@+id/live_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#FFFFB27F"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/live_advice_bg"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/live_advice_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="下一步建议"
                android:textColor="#CCFFE6D2"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/live_advice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
